	const $countWrap = $('#countDown');
	if ($countWrap.length) {
		const deadline = new Date(($countWrap.data('deadline') || '').replace(/-/g, '/'));
		const $cd = {
			day : $countWrap.find('[data-cd="day"]'),
			hour: $countWrap.find('[data-cd="hour"]'),
			min : $countWrap.find('[data-cd="min"]'),
			sec : $countWrap.find('[data-cd="sec"]')
		};

		function pad2Cd(n) {
			return String(n).padStart(2, '0');
		}

		function updateCountDown() {
			const diff = deadline - new Date();

			if (isNaN(diff) || diff <= 0) {
				$cd.day.text('00');
				$cd.hour.text('00');
				$cd.min.text('00');
				$cd.sec.text('00');
				return false;
			}

			$cd.day.text(Math.floor(diff / 86400000));
			$cd.hour.text(pad2Cd(Math.floor(diff / 3600000) % 24));
			$cd.min.text(pad2Cd(Math.floor(diff / 60000) % 60));
			$cd.sec.text(pad2Cd(Math.floor(diff / 1000) % 60));
			return true;
		}

		updateCountDown();
		const cdTimer = setInterval(function () {
			if (!updateCountDown()) clearInterval(cdTimer);
		}, 1000);
	}
