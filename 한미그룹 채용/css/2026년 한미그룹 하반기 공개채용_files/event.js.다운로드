// 팝업----------------------------------------------------------------------------------
// 팝업이 열릴 때 스크롤 막기
// ------------------------------------
// 전역 설정
// ------------------------------------
let __isLocked = false;
const __KEYS_BLOCK = new Set([32, 33, 34, 35, 36, 37, 38, 39, 40]); // Space, PgUp/Down, Home/End, Arrows
const __targets = [window, document, document.documentElement];
let __touchStartY = 0;

// 팝업 내부 스크롤 영역 셀렉터(필요 시 추가)
const SCROLL_SEL = '.scroll-y, [data-scrollable="y"]';

// 스크롤 가능한 조상 찾기(팝업 안에서만)
function getScrollableAncestor(target) {
	let el = target instanceof Element ? target : null;
	if (!el) return null;
	// 팝업 범위 확인(팝업 루트에 .popup 클래스가 없다면 #jopIntroPopup로 바꾸세요)
	if (!$(el).closest('.popup, #jopIntroPopup').length) return null;

	while (el && el !== document.body) {
		const $el = $(el);
		const cs = getComputedStyle(el);
		const isMatch = $el.is(SCROLL_SEL) || /(auto|scroll)/.test(cs.overflowY);
		if (isMatch && el.scrollHeight > el.clientHeight) return el;
		el = el.parentElement;
	}
	return null;
}

function canScroll(el, deltaY) {
	const top = el.scrollTop;
	const max = el.scrollHeight - el.clientHeight;
	if (deltaY < 0 && top <= 0) return false;      // 위로 더 못 감
	if (deltaY > 0 && top >= max - 1) return false; // 아래로 더 못 감(반올림 보정)
	return true;
}

function getDeltaY(e) {
	if (e.type === 'wheel') {
		// 표준 wheel
		return e.deltaY || (-e.wheelDelta) || e.detail || 0;
	} else if (e.type === 'touchmove' && e.touches && e.touches[0]) {
		const dy = __touchStartY - e.touches[0].clientY; // 손가락 ↓(컨텐츠 ↑)=양수
		return dy;
	}
	return 0;
}

function onWheelTouch(e) {
	const scroller = getScrollableAncestor(e.target);

	if (scroller) {
		const dy = getDeltaY(e);
		if (dy === 0) {
			// 멀티축/가벼운 이동 등: 내부만 처리하게 전파 차단
			e.stopPropagation();
			return;
		}
		if (canScroll(scroller, dy)) {
			// 내부 스크롤 가능 → 기본 스크롤 허용 + 바깥 전파만 차단
			e.stopPropagation();
			return;
		} else {
			// 내부가 더 못 움직이는 엣지 → 바깥(사이트)로 체이닝 금지
			e.preventDefault();
			e.stopImmediatePropagation();
			return;
		}
	}

	// 팝업 외부거나 스크롤러 없음 → 전역 차단 (사이트 스크롤 금지)
	e.preventDefault();
	e.stopImmediatePropagation();
}

function onKeydown(e) {
	if (!__KEYS_BLOCK.has(e.keyCode)) return;

	// 입력창/셀렉트는 통과
	const t = e.target;
	const tag = t.tagName;
	const editable = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || t.isContentEditable;
	if (editable) return;

	const scroller = getScrollableAncestor(t);
	if (scroller) {
		// 내부 스크롤 가능한 경우 키보드 스크롤 허용(전파만 차단)
		e.stopPropagation();
		return;
	}

	// 아니면 막기
	e.preventDefault();
	e.stopImmediatePropagation();
}

function lockScroll() {
	if (__isLocked) return;
	__isLocked = true;

	if (window.lenis?.stop) window.lenis.stop();

	__targets.forEach(t => {
		t.addEventListener('wheel', onWheelTouch, {passive: false, capture: true});
		t.addEventListener('touchmove', onWheelTouch, {passive: false, capture: true});
		t.addEventListener('keydown', onKeydown, true);
		t.addEventListener('touchstart', e => {
			if (e.touches && e.touches[0]) __touchStartY = e.touches[0].clientY;
		}, {passive: true, capture: true});
	});

	document.documentElement.classList.add('scroll-locked');
}

function unlockScrollIfNoPopup() {
	if ($('.popup:visible, #jopIntroPopup:visible').length > 0) return;
	if (!__isLocked) return;
	__isLocked = false;

	__targets.forEach(t => {
		t.removeEventListener('wheel', onWheelTouch, {capture: true});
		t.removeEventListener('touchmove', onWheelTouch, {capture: true});
		t.removeEventListener('keydown', onKeydown, true);
		// touchstart는 여러 익명 핸들러가 생기지 않도록 상단으로 빼고 싶다면 별도 함수로 분리하세요.
	});

	document.documentElement.classList.remove('scroll-locked');
	if (window.lenis?.start) window.lenis.start();
}

// ===== 팝업 열기/닫기 =====
function openPopup(id, type, triggerEl) {
	const $popup = $(id);
	if (!$popup.length) return;

	// 1) 모든 pop-cont 숨김
	$popup.find('.pop-cont').hide();

	// 2) 트리거에서 목표 선택자 읽기
	let $target = null;
	if (triggerEl) {
		const sel = $(triggerEl).data('cont'); // ".popup-xxxx"
		if (sel) $target = $popup.find(sel);
	}

	// 3) 예외/보호: 못 찾으면 첫 번째 섹션 노출
	if (!$target || !$target.length) {
		$target = $popup.find('.pop-cont').first();
	}

	// 4) 해당 섹션만 노출
	$target.css('display', 'flex');

	// 5) 팝업 띄우기
	lockScroll(); // 레이아웃 고정/바디 스크롤 차단 (레이아웃은 건드리지 않고 스크롤만 차단)

	$('.popup-bg').stop(true, true);
	$popup.stop(true, true);

	if (type === "fade") {
		$popup.attr('data-open-type', 'fade').fadeIn(200);
		$('.popup-bg').fadeIn(200);
	} else {
		$popup.attr('data-open-type', 'normal').show();
		$('.popup-bg').show();
	}

	// 스크롤 영역 맨 위로
	// (display:none 상태에서는 scrollTop 이 먹지 않으므로 팝업을 띄운 뒤에 초기화합니다)
	const resetScroll = function () {
		$target.find('.scroll-y').scrollTop(0);
	};
	resetScroll();
	requestAnimationFrame(resetScroll);
}


function closePopup(trigger, type) {
	const $popup = $(trigger).closest('.popup');
	if ($popup.length === 0) return;

	const afterHide = () => {
		if ($('.popup:visible').length === 0) {
			$('.popup-bg').stop(true, true).fadeOut ? $('.popup-bg').fadeOut(200) : $('.popup-bg').hide();
		}
		unlockScrollIfNoPopup();
	};

	$popup.stop(true, true);
	if (type === "fade") {
		$popup.attr('data-open-type', 'fade').fadeOut(200, afterHide);
	} else {
		$popup.attr('data-open-type', 'normal').hide();
		afterHide();
	}
}
