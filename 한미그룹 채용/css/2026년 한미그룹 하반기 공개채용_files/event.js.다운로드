	/* --------------------------------------------------
		여러 줄 텍스트 : <br> 기준으로 줄을 분리해 한 줄씩 등장
		- txtLines() 가 등장 대상(줄)을 돌려주고 초기값까지 맞춰줍니다.
		- <br> 이 없는 텍스트는 기존과 동일하게 통째로 등장합니다.
	-------------------------------------------------- */
	function splitTextLines(el) {
		if (el.dataset.lineSplit === '1' || !el.querySelector('br')) {
			return;
		}
		el.innerHTML = el.innerHTML
		.split(/<br\s*\/?>/i)
		.map(function (line) {
			return '<span class="tl-line"><span class="tl-line-in">' + line.trim() + '</span></span>';
		})
		.join('');
		el.dataset.lineSplit = '1';
	}

	function txtLines(selector) {
		const targets = [];

		gsap.utils.toArray(selector).forEach(function (el) {
			splitTextLines(el);

			const lines = el.querySelectorAll('.tl-line-in');
			if ( lines.length ) {
				// 줄을 나눈 경우 : 부모는 그대로 두고 줄 단위로 등장시킵니다.
				gsap.set(el, {opacity: 1, y: 0});
				gsap.set(lines, {opacity: 0, y: 100});
				targets.push.apply(targets, lines);
			}
			else {
				targets.push(el);
			}
		});

		return targets;
	}

