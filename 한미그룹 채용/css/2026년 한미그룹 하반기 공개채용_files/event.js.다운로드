$(document).ready(function () {
	gsap.registerPlugin(ScrollTrigger);
	const mm = gsap.matchMedia();

	function setVHUnit() {
		let vh = window.innerHeight * 0.01;
		document.documentElement.style.setProperty('--vh', `${vh}px`);
	}

	window.addEventListener('resize', setVHUnit);
	setVHUnit();

	// 커서
	const body = $('body');
	const $cursor = $('.cursor-scroll');
	const arrowEl = document.querySelector('.cursor-arrow'); // 히어로 밖 가짜 화살표 커서
	const SCOPE = '#mVisual, .section1'; // 가짜 커서 허용 구역
	const canHover = window.matchMedia('(hover: hover)').matches;

	// 1) 페이지 로드 시 기본으로 '가짜 커서' 켜두기
	if (window.matchMedia('(hover: hover)').matches) {
		body.addClass('use-hero-cursor');
	}

	// 2) 마우스가 어디 위에 있는지에 따라 즉시 전환
	//    - 허용 구역 안이면 use-hero-cursor 유지
	//    - 밖이면 제거 → 작은 이미지 커서로 전환
	let targetX = 0, targetY = 0, nowX = 0, nowY = 0; // 가짜 커서 위치
	let mouseX = -1, mouseY = -1;                     // 마지막 마우스 위치 (스크롤 시 재판정용, -1 = 아직 모름)
	const ease = 0.18;

	function updateHeroCursor(el) {
		if (!canHover) return;
		const inside = !!el && $(el).closest(SCOPE).length > 0;
		body.toggleClass('use-hero-cursor', inside);
		// 히어로 밖 + 좌표를 아는 상태에서만 화살표 커서 (좌표 모르면 cursor:url 폴백 유지)
		body.toggleClass('use-arrow-cursor', !!arrowEl && !inside && mouseX >= 0);
	}

	// 마우스가 창 밖으로 나가면 화살표 숨김, 들어오면 다시 판정
	document.addEventListener('mouseleave', function () {
		body.removeClass('use-arrow-cursor');
	});
	document.addEventListener('mouseenter', function (e) {
		mouseX = e.clientX;
		mouseY = e.clientY;
		updateHeroCursor(document.elementFromPoint(mouseX, mouseY));
	});

	$(document).on('mouseover', function (e) {
		updateHeroCursor(e.target);
	});

	// 마우스를 움직이지 않고 스크롤만 해도 구역 경계를 지나면 바뀌도록,
	// 스크롤 중에는 마지막 마우스 위치 아래의 요소를 다시 판정합니다.
	// (휠 이벤트도 좌표를 갖고 있어 마우스를 한 번도 안 움직인 경우까지 커버)
	window.addEventListener('wheel', function (e) {
		mouseX = e.clientX;
		mouseY = e.clientY;
	}, {passive: true});

	let cursorScrollRaf = 0;
	window.addEventListener('scroll', function () {
		if (mouseX < 0 || cursorScrollRaf) return;
		cursorScrollRaf = requestAnimationFrame(function () {
			cursorScrollRaf = 0;
			updateHeroCursor(document.elementFromPoint(mouseX, mouseY));
			targetX = mouseX;
			targetY = mouseY;
		});
	}, {passive: true});

	// 3) 가짜 커서 따라오기 (Scroll 원형은 부드럽게, 화살표는 즉시)
	$(document).on('mousemove', function (e) {
		mouseX = e.clientX;
		mouseY = e.clientY;
		if (arrowEl) {
			arrowEl.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`; // 핫스팟 = 이미지 좌상단(화살표 끝)
			if (canHover && !body.hasClass('use-hero-cursor')) body.addClass('use-arrow-cursor');
		}
		if (!body.hasClass('use-hero-cursor')) return;
		targetX = e.clientX;
		targetY = e.clientY;
	});

	(function raf_cursor() {
		nowX += (targetX - nowX) * ease;
		nowY += (targetY - nowY) * ease;
		if (body.hasClass('use-hero-cursor')) {
			// 80은 가짜 커서 지름
			$cursor.css('transform', `translate(${nowX - 40}px, ${nowY - 40}px)`);
		}
		requestAnimationFrame(raf_cursor);
	})();

	// 헤더 이벤트
	let lastScrollTop = 0;
	const $header = $('#header .header-body');
	const isMobile = $(window).width() <= 860;

	$(window).scroll(function () {
		const currentScrollTop = $(this).scrollTop();
		const scrollingDown = currentScrollTop > lastScrollTop;

		// 헤더 처리
		if (!$('.mo-toggle').hasClass('active')) {
			// $header.css('transform', `translateY(${scrollingDown ? 'calc(-100% - 30px)' : '0'})`);
			$header.css('transform', `translateY(${scrollingDown && currentScrollTop > 0 ? 'calc(-100% - 30px)' : '0'})`)
		}

		lastScrollTop = currentScrollTop;

		setTimeout(() => {
			if (isMobile && currentScrollTop == 0) {
				$('#header .header-body').css('transform', 'translateY(0)');
			}
		}, 500);
	});
	// 헤더 이벤트 끝

	// 헤더 메뉴 클릭 이벤트 - 네비게이션 점프 (Lenis 즉시 정지 + 즉시 이동)
	const SECTIONS = ['.section7', '.section8', '.section9'];

	// Lenis 인스턴스 안전하게 얻기
	function getLenis() {
		try {
			if (window.lenis) return window.lenis;
			// 전역 변수로 선언된 경우 대비
			if (typeof lenis !== 'undefined') return lenis;
		} catch (e) {
		}
		return null;
	}

	// 진행 중인 관성(모멘텀) 즉시 끊기
	function stopMomentum() {
		// 혹시 남아있을 jQuery 애니메이션 중단
		$('html, body').stop(true, true);

		const L = getLenis();
		if (L && typeof L.scrollTo === 'function') {
			try {
				// 현재 위치로 즉시 스냅 → 관성 종료
				L.scrollTo(window.scrollY, {immediate: true});
				return;
			} catch (e) {
			}
		}
		// 폴백: 네이티브로 현재 위치 고정
		window.scrollTo({top: window.scrollY, left: 0, behavior: 'auto'});
	}

	function getHeaderH() {
		const $fixed = $('.header.is-fixed, .header.fixed, .gnb, .site-header').first();
		return $fixed.length ? $fixed.outerHeight() : 0;
	}

	// 앞 섹션 마지막 항목의 1px border 가 화면 맨 위에 걸리지 않도록 살짝 더 내려 줍니다.
	const NAV_TOP_NUDGE = 2;

	/* 섹션마다 제목 위 여백(.tit-box 의 padding-top)이 다릅니다.
	   section8 / section9 는 이 여백이 0 이라 섹션 맨 위로 이동하면 제목이 화면 위로 잘립니다.
	   여백이 살아 있는 section7 을 기준으로 삼아, 모자란 만큼 더 위에서 멈추게 합니다.
	   (반응형에서 .tit-box 여백이 200/140/80px 로 줄어드는 것도 그대로 따라갑니다) */
	function getTitBoxPad($el) {
		const $tit = $el.find('.tit-box').first();
		return $tit.length ? (parseFloat($tit.css('padding-top')) || 0) : 0;
	}

	function getTargetTopByIndex(i) {
		const clamped = Math.max(0, Math.min(SECTIONS.length - 1, i));
		const sel = SECTIONS[clamped];
		const $el = $(sel);
		if (!$el.length) return 0;

		let top = $el.offset().top;

		// 제목이 항상 같은 위치에 오도록 여백 차이만큼 보정
		top -= Math.max(0, getTitBoxPad($('.section7')) - getTitBoxPad($el));

		/* 앞 섹션 .cont-wrap 의 padding-bottom 이 200px 라, 위 보정과 딱 맞아떨어지면서
		   마지막 항목의 1px border 가 화면 맨 위에 걸쳐 보입니다. 살짝 더 내려서 가립니다. */
		top += NAV_TOP_NUDGE;

		top -= getHeaderH();
		return Math.max(0, Math.round(top));
	}

	// data 캐시를 피하기 위해 attr로 먼저 시도, 실패하면 li 인덱스로 폴백
	function resolveIdx($a) {
		const raw = $a.attr('data-idx'); // attr 사용
		let idx = parseInt(raw, 10);
		if (Number.isNaN(idx)) {
			idx = $a.closest('li').index(); // 폴백
		}
		return idx;
	}

	// Lenis 관성 끊고 Lenis로 스크롤(폴백: jQuery animate)
	function goTo($a) {
		// 모바일 메뉴 닫힘으로 레이아웃 변할 수 있으니 먼저 닫음
		if (typeof mobile !== 'undefined' && typeof mobile.rightClose === 'function') {
			mobile.rightClose();
		}
		$('.mo-toggle').removeClass('active');

		// ★ 클릭 즉시 관성 끊기
		stopMomentum();

		// 레이아웃 안정화 후 타깃 계산
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				const idx = resolveIdx($a);
				const top = getTargetTopByIndex(idx);

				const L = getLenis();
				if (L && typeof L.scrollTo === 'function') {
					L.scrollTo(top, {
						duration: 0.6, // 필요시 조절
						easing  : (t) => 1 - Math.pow(1 - t, 3)
					});
				} else {
					$('html, body').stop(true, true).animate({scrollTop: top}, 500);
				}
			});
		});
	}

	// iOS 클릭 지연 회피용 - pointerdown 우선 처리
	let NAV_LOCK = false;

	function handleNav(e) {
		e.preventDefault();
		e.stopPropagation();
		if (NAV_LOCK) return;
		NAV_LOCK = true;

		goTo($(e.currentTarget));

		// 연타 방지(필요 시 시간 조절)
		setTimeout(() => {
			NAV_LOCK = false;
		}, 400);
	}

	// 바인딩을 pointerdown 우선, click은 백업
	$(document)
	.off('.navjump')
	.on('pointerdown.navjump', '.header-nav .depth1 > li > a', handleNav)
	.on('click.navjump', '.header-nav .depth1 > li > a', function (e) {
		if (!NAV_LOCK) handleNav(e);
	});

	// 리사이즈 시엔 캐시 안 둠. 클릭 순간에 항상 fresh 계산.
	$(window).on('resize orientationchange', function () {
		// nothing; 클릭 시 매번 재계산
	});
	// ------------헤더 메뉴 클릭 이벤트 끝

	// 복제된 롤링 카드도 해당 직무 탭을 연 뒤 헤더 직무소개 메뉴와 같은 위치로 이동합니다.
	$(document).on('click', '.mv-job-box', function (e) {
		e.preventDefault();
		const $card = $(this);
		const jobKey = $card.attr('data-job-tab');
		$('.section7 .tab-box a').filter(function () {
			return $(this).attr('data-job-tab') === jobKey;
		}).first().trigger('click');
		goTo($card);
	});

	// 탭박스 클릭 이벤트(공통)
	const tabBox = $('.tab-box');
	const tabItem = tabBox.find('a');
	tabItem.on('click', function () {
		$(this).closest('.tab-box').find('a').removeClass('on');
		$(this).addClass('on');
	});

	// section7 모집직무 리스트 클릭 이벤트
	const $list = $('.job-info-list');
	const $items = $list.children('li');

	$items.on('click', function (e) {
		const $li = $(this);
		const $panel = $li.children('.job-grid');
		const isOpen = $li.hasClass('on');

		// 1) 다른 항목은 모두 닫기
		$items.removeClass('on')
		.children('.job-grid')
		.stop(true, true)
		.slideUp(300);

		if (!isOpen) {
			$li.addClass('on');
			$panel
			.css('display', 'grid')
			.hide()
			.stop(true, true)
			.slideDown(300, function () {
				// 애니 끝나고도 grid 유지(브라우저별 안전장치)
				$(this).css('display', 'grid');
			});
		}
	});
	// 카드 목록 내부 클릭 시 li 이벤트로 전파 막기
	$list.find('.job-grid').on('click', function (e) {
		e.stopPropagation();
	});

	/* --------------------------------------------------
		section5 복지 리스트 스크롤바
		- 시안의 스크롤바는 리스트 상단이 아니라 첫 박스가 시작되는
		  65px 지점부터 시작하므로 네이티브 스크롤바 대신 직접 그립니다.
	-------------------------------------------------- */
	(function () {
		const $box = $('.benefit-box');
		if ( !$box.length ) return;

		const $scroll = $box.find('.benefit-scroll');
		const $bar    = $box.find('.benefit-bar');
		const $thumb  = $bar.find('.thumb');
		const el      = $scroll.get(0);
		if ( !el ) return;

		function sync() {
			const track = $bar.height();
			const ratio = el.clientHeight / el.scrollHeight;

			if ( !track || ratio >= 1 ) {
				$bar.removeClass('is-on');
				return;
			}
			$bar.addClass('is-on');

			const thumbH = Math.max(20, Math.round(track * ratio));
			const max    = el.scrollHeight - el.clientHeight;
			const top    = max > 0 ? (track - thumbH) * (el.scrollTop / max) : 0;

			$thumb.css({height: thumbH, transform: 'translateY(' + Math.round(top) + 'px)'});
		}

		$scroll.on('scroll', sync);
		$(window).on('resize load', sync);
		if ( window.ResizeObserver ) {
			const $inner = $scroll.find('.benefit-inner');
			if ( $inner.length ) new ResizeObserver(sync).observe($inner.get(0));
		}
		sync();

		// 썸 드래그
		let dragY = null, startTop = 0;
		$thumb.on('mousedown', function (e) {
			e.preventDefault();
			dragY    = e.clientY;
			startTop = el.scrollTop;
			$('body').css('user-select', 'none');
		});
		$(document).on('mousemove.benefitbar', function (e) {
			if ( dragY === null ) return;
			const track  = $bar.height();
			const thumbH = $thumb.outerHeight();
			const max    = el.scrollHeight - el.clientHeight;
			if ( track - thumbH <= 0 ) return;
			el.scrollTop = startTop + (e.clientY - dragY) * max / (track - thumbH);
		}).on('mouseup.benefitbar', function () {
			if ( dragY === null ) return;
			dragY = null;
			$('body').css('user-select', '');
		});

		// 트랙 클릭
		$bar.on('mousedown', function (e) {
			if ( e.target !== this ) return;
			const rect   = this.getBoundingClientRect();
			const thumbH = $thumb.outerHeight();
			const max    = el.scrollHeight - el.clientHeight;
			if ( rect.height - thumbH <= 0 ) return;
			const pos = (e.clientY - rect.top - thumbH / 2) / (rect.height - thumbH);
			el.scrollTop = Math.max(0, Math.min(1, pos)) * max;
		});
	})();

	/* --------------------------------------------------
		내부 스크롤 영역 ↔ 화면 스크롤 이어주기
		- data-lenis-prevent 가 붙어 있으면 Lenis 가 그 영역의 휠/터치를
		  항상 무시하므로, 안쪽 스크롤이 끝까지 가도 화면이 움직이지 않습니다.
		- 스크롤 방향과 현재 위치를 보고 위/아래 끝에 닿았을 때만
		  data-lenis-prevent 를 떼서 화면 스크롤로 넘겨줍니다.
		- Lenis 는 window 에 버블 단계로 붙으므로, 캡처 단계에서 미리
		  속성을 정해두면 같은 이벤트에 바로 반영됩니다.
	-------------------------------------------------- */
	function bindEdgeScroll(el) {
		if ( !el || el.dataset.edgeScroll ) return;
		el.dataset.edgeScroll = '1';

		const EPS = 1;

		// dir > 0 : 아래로 스크롤, dir < 0 : 위로 스크롤
		function isEdge(dir) {
			const max = el.scrollHeight - el.clientHeight;
			if ( max <= EPS ) return true;                    // 안쪽에 스크롤이 없으면 바로 화면 스크롤
			if ( dir > 0 ) return el.scrollTop >= max - EPS;  // 끝까지 내린 상태
			if ( dir < 0 ) return el.scrollTop <= EPS;        // 끝까지 올린 상태
			return false;
		}

		function update(dir) {
			if ( isEdge(dir) ) el.removeAttribute('data-lenis-prevent');
			else el.setAttribute('data-lenis-prevent', '');
		}

		el.addEventListener('wheel', function (e) {
			update(e.deltaY);
		}, {passive: true, capture: true});

		let touchY = 0;

		el.addEventListener('touchstart', function (e) {
			touchY = e.touches[0].clientY;
		}, {passive: true, capture: true});

		el.addEventListener('touchmove', function (e) {
			const y = e.touches[0].clientY;
			update(touchY - y); // 손가락을 위로 밀면 아래로 스크롤
			touchY = y;
		}, {passive: true, capture: true});
	}

	// section5 복지 리스트
	$('.benefit-scroll').each(function () {
		bindEdgeScroll(this);
	});

	// section7(모집직무) 탭박스 클릭 이벤트
	const $sec7Tab = $('.section7 .tab-box a');
	$sec7Tab.on('click', function () {
		const idx = $(this).data('idx');
		const $panels = $('.section7 .job-panel');

		$panels.removeClass('on');
		$panels.filter('[data-idx="' + idx + '"]').addClass('on');

		// 패널 전환 시 아코디언은 모두 접힌 기본 상태로 되돌립니다.
		const $cur = $panels.filter('[data-idx="' + idx + '"]');
		$cur.find('.job-info-list > li').removeClass('on').children('.job-grid').stop(true, true).hide();

		if (window.ScrollTrigger) ScrollTrigger.refresh();
	});
	// section7 탭박스 클릭 이벤트 끝

	// section8 탭박스 클릭 이벤트
	// ====== 캐시 ======
	const $sec8 = $('.section8');
	const $tabs = $('.section8 .tab-box a');
	const $area1 = $('.section8 .area1');
	const $area2 = $('.section8 .area2');
	const $body = $('.section8 .section-body');

	// ====== 유틸 ======
	function raf2(fn) {
		requestAnimationFrame(() => requestAnimationFrame(fn));
	}

	function waitImages($wrap, done) {
		const $imgs = $wrap.find('img').filter(function () {
			return !this.complete || this.naturalWidth === 0;
		});
		if (!$imgs.length) return done();
		let left = $imgs.length;
		$imgs.on('load error', () => (--left <= 0) && done());
	}

	function measureBodyHeight() {
		return Math.max($body[0]?.scrollHeight || 0, $body.outerHeight(true) || 0);
	}

	// ▶︎ 현재 보이는 컨텐츠 기준 “정확히” 재설정(증가/감소 모두 반영)
	function setExactMinHeight() {
		// 1) 초기화
		$sec8.css({height: '', minHeight: ''});

		// 2) 레이아웃 확정
		if ($sec8[0]) void $sec8[0].offsetHeight;

		// 3) 정확한 자연 높이
		const h = measureBodyHeight();

		// 4) 세팅
		if (h > 0) $sec8.css('min-height', h);
	}

	// 강제 리프레시(스크롤/핀/사파리 보정)
	function hardRefresh() {
		// 1) 잠재적 스크롤 잠금 해제
		$('html, body').css({overflow: '', height: ''});

		// 2) 레이아웃 확정 → 정확 높이 반영
		if ($sec8[0]) void $sec8[0].offsetHeight;
		setExactMinHeight();

		// 3) ScrollTrigger 재계산(2회 보정)
		if (window.ScrollTrigger) {
			ScrollTrigger.refresh();
			setTimeout(() => ScrollTrigger.refresh(), 60);
			if (window.ScrollSmoother?.get) {
				try {
					ScrollSmoother.get().refresh();
				} catch (e) {
				}
			}
		}

		// 4) 문서 높이 재평가 이벤트 (일부 브라우저)
		window.dispatchEvent(new Event('resize'));
	}

